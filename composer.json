{
	"name": "divi-buddy/divi-buddy",
	"description": "Site-wide design settings for Divi 5, synced into Divi's Global Variables.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"brain/monkey": "^2.6"
	},
	"autoload-dev": {
		"psr-4": {
			"DiviBuddy\\": "includes/",
			"DiviBuddy\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.1.29"
		}
	}
}
